# Line endings are repo policy, not a per-machine setting.
#
# The stored content here is already LF throughout; what varies is the working
# tree, because core.autocrlf is set on some machines and not on others. That
# is fine until someone clones without it and commits CRLF back in, at which
# point every line of a file shows as changed and the real edit is lost in it.
#
# eol=lf rather than the default: these are ReaScripts. Lua, REAPER and every
# editor involved read LF happily on Windows, and keeping one ending everywhere
# means a copy of the script sitting outside the repo -- an install under
# REAPER/Scripts, say -- compares byte for byte against the source.

* text=auto eol=lf

# Left exactly as they are. Marking them explicitly rather than relying on
# git's content sniffing, which has been known to decide a PDF is text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.wav  binary
*.mid  binary
*.zip  binary
*.dll  binary
