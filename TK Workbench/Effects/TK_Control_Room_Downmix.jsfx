desc:TK Control Room Downmix
author:TouristKiller
version:0.4

// Writes monitoring pairs onto spare channels of the same track, so a check can
// be listened to without altering the bed feeding the main outputs. One instance
// serves every check at once: the fold-down of a multichannel bed lands on the
// fold offset, the mid two channels above it, then the side, the low band and
// the high band. A pair nobody listens to is switched off rather than removed,
// so the ones in use never shift channel.
// The output pairs must sit outside the source bed or the output feeds back.

in_pin:1
in_pin:2
in_pin:3
in_pin:4
in_pin:5
in_pin:6
in_pin:7
in_pin:8
in_pin:9
in_pin:10
in_pin:11
in_pin:12
in_pin:13
in_pin:14
in_pin:15
in_pin:16
in_pin:17
in_pin:18
in_pin:19
in_pin:20
in_pin:21
in_pin:22
in_pin:23
in_pin:24
in_pin:25
in_pin:26
in_pin:27
in_pin:28
in_pin:29
in_pin:30
in_pin:31
in_pin:32
out_pin:1
out_pin:2
out_pin:3
out_pin:4
out_pin:5
out_pin:6
out_pin:7
out_pin:8
out_pin:9
out_pin:10
out_pin:11
out_pin:12
out_pin:13
out_pin:14
out_pin:15
out_pin:16
out_pin:17
out_pin:18
out_pin:19
out_pin:20
out_pin:21
out_pin:22
out_pin:23
out_pin:24
out_pin:25
out_pin:26
out_pin:27
out_pin:28
out_pin:29
out_pin:30
out_pin:31
out_pin:32

slider1:3<0,7,1{Mono,Stereo,Quad,5.1,7.1,7.1.2,7.1.4,9.1.6}>Source Layout
slider2:0<0,30,1>Source Offset (ch)
slider3:6<0,30,1>Fold Offset (ch)
slider4:-3<-12,0,0.1>Center Level (dB)
slider5:-3<-12,0,0.1>Surround Level (dB)
slider6:0<0,1,1{Off,On}>Include LFE
// LFE is reproduced 10 dB above the other channels, so a fold-down that means
// to represent what a surround listener hears needs to reach +10 here.
slider7:0<-24,10,0.1>LFE Level (dB)
slider8:0<-12,12,0.1>Output Trim (dB)
slider9:1<0,1,1{Off,On}>Run
slider10:1<0,1,1{Off,On}>Fold-down Pair
slider11:0<0,1,1{Off,On}>Mid Pair
slider12:0<0,1,1{Off,On}>Side Pair
slider13:0<0,1,1{Off,On}>Low Pair
slider14:0<0,1,1{Off,On}>High Pair
slider15:120<40,1000,1>Crossover (Hz)
// Height channels fold in at their own level. Appended after Crossover on
// purpose: the parameter indices before it are addressed by name from Lua.
slider16:-3<-12,0,0.1>Height Level (dB)

@init
c_gain = 0.707945784;
s_gain = 0.707945784;
lfe_gain = 0;
h_gain = 0.707945784;
trim = 1;
lay = 3;
src = 0;
dst = 6;
width = 6;

function reset_filters()
(
  lx1l = lx2l = ly1l = ly2l = lx1r = lx2r = ly1r = ly2r = 0;
  hx1l = hx2l = hy1l = hy2l = hx1r = hx2r = hy1r = hy2r = 0;
);

// RBJ biquad at Q = 1/sqrt(2), enough to tell a band apart by ear.
function calc_biquad(freq, highpass) local(w0, cs, sn, alpha, a0)
(
  w0 = 2 * $pi * min(max(freq, 20), srate * 0.45) / srate;
  cs = cos(w0);
  sn = sin(w0);
  alpha = sn / 1.41421356;
  a0 = 1 + alpha;
  highpass ? (
    q_b0 = ((1 + cs) * 0.5) / a0;
    q_b1 = -(1 + cs) / a0;
  ) : (
    q_b0 = ((1 - cs) * 0.5) / a0;
    q_b1 = (1 - cs) / a0;
  );
  q_b2 = q_b0;
  q_a1 = (-2 * cs) / a0;
  q_a2 = (1 - alpha) / a0;
);

@slider
lay = min(7, max(0, floor(slider1)));
src = max(0, floor(slider2));
dst = max(0, floor(slider3));
c_gain = pow(10, slider4 / 20);
s_gain = pow(10, slider5 / 20);
lfe_gain = slider6 >= 0.5 ? pow(10, slider7 / 20) : 0;
trim = pow(10, slider8 / 20);
h_gain = pow(10, slider16 / 20);
lay == 0 ? width = 1 : lay == 1 ? width = 2 : lay == 2 ? width = 4 :
lay == 3 ? width = 6 : lay == 4 ? width = 8 : lay == 5 ? width = 10 :
lay == 6 ? width = 12 : width = 16;
calc_biquad(slider15, 0);
lp_b0 = q_b0; lp_b1 = q_b1; lp_b2 = q_b2; lp_a1 = q_a1; lp_a2 = q_a2;
calc_biquad(slider15, 1);
hp_b0 = q_b0; hp_b1 = q_b1; hp_b2 = q_b2; hp_a1 = q_a1; hp_a2 = q_a2;
reset_filters();

@block
// Each pair is judged on its own, so a track too narrow for the high band still
// carries the ones that do fit. The output must stay clear of the bed it reads.
base_ok = slider9 >= 0.5 && dst >= src + width;
run_fold = base_ok && slider10 >= 0.5 && dst + 2 <= num_ch;
run_mid = base_ok && slider11 >= 0.5 && dst + 4 <= num_ch;
run_side = base_ok && slider12 >= 0.5 && dst + 6 <= num_ch;
run_low = base_ok && slider13 >= 0.5 && dst + 8 <= num_ch;
run_high = base_ok && slider14 >= 0.5 && dst + 10 <= num_ch;
active = run_fold || run_mid || run_side || run_low || run_high;

@sample
active ? (
  lay >= 3 ? (
    dl = spl(src) + c_gain * spl(src + 2) + lfe_gain * spl(src + 3) + s_gain * spl(src + 4);
    dr = spl(src + 1) + c_gain * spl(src + 2) + lfe_gain * spl(src + 3) + s_gain * spl(src + 5);
    // Back pair, from 7.1 up.
    lay >= 4 ? (
      dl += s_gain * spl(src + 6);
      dr += s_gain * spl(src + 7);
    );
    // 7.1.2 carries one height pair at 8/9. 7.1.4 has two, at 8/9 and 10/11.
    lay == 5 ? (
      dl += h_gain * spl(src + 8);
      dr += h_gain * spl(src + 9);
    ) : lay == 6 ? (
      dl += h_gain * (spl(src + 8) + spl(src + 10));
      dr += h_gain * (spl(src + 9) + spl(src + 11));
    ) : lay == 7 ? (
      // 9.1.6: wides at 8/9 are off-axis front positions and fold at the
      // surround level, then three height pairs from 10 up.
      dl += s_gain * spl(src + 8) + h_gain * (spl(src + 10) + spl(src + 12) + spl(src + 14));
      dr += s_gain * spl(src + 9) + h_gain * (spl(src + 11) + spl(src + 13) + spl(src + 15));
    );
  ) : lay == 2 ? (
    dl = spl(src) + s_gain * spl(src + 2);
    dr = spl(src + 1) + s_gain * spl(src + 3);
  ) : lay == 1 ? (
    dl = spl(src);
    dr = spl(src + 1);
  ) : (
    dl = spl(src);
    dr = spl(src);
  );
  run_fold ? (
    spl(dst) = dl * trim;
    spl(dst + 1) = dr * trim;
  );
  run_mid ? (
    mid_s = (dl + dr) * 0.5 * trim;
    spl(dst + 2) = mid_s;
    spl(dst + 3) = mid_s;
  );
  run_side ? (
    // Side decoded back to a pair rather than summed, so a wide element keeps
    // its position instead of collapsing to the middle.
    side_s = (dl - dr) * 0.5 * trim;
    spl(dst + 4) = side_s;
    spl(dst + 5) = -side_s;
  );
  run_low ? (
    o_l = lp_b0 * dl + lp_b1 * lx1l + lp_b2 * lx2l - lp_a1 * ly1l - lp_a2 * ly2l;
    lx2l = lx1l; lx1l = dl; ly2l = ly1l; ly1l = o_l;
    o_r = lp_b0 * dr + lp_b1 * lx1r + lp_b2 * lx2r - lp_a1 * ly1r - lp_a2 * ly2r;
    lx2r = lx1r; lx1r = dr; ly2r = ly1r; ly1r = o_r;
    spl(dst + 6) = o_l * trim;
    spl(dst + 7) = o_r * trim;
  );
  run_high ? (
    o_l = hp_b0 * dl + hp_b1 * hx1l + hp_b2 * hx2l - hp_a1 * hy1l - hp_a2 * hy2l;
    hx2l = hx1l; hx1l = dl; hy2l = hy1l; hy1l = o_l;
    o_r = hp_b0 * dr + hp_b1 * hx1r + hp_b2 * hx2r - hp_a1 * hy1r - hp_a2 * hy2r;
    hx2r = hx1r; hx1r = dr; hy2r = hy1r; hy1r = o_r;
    spl(dst + 8) = o_l * trim;
    spl(dst + 9) = o_r * trim;
  );
);
