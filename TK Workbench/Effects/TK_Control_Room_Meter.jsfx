desc:TK Control Room Meter
author:TouristKiller
version:0.5

in_pin:Left
in_pin:Right
in_pin:Center
in_pin:LFE
in_pin:Surround L
in_pin:Surround R
in_pin:Back L
in_pin:Back R
in_pin:Wide L
in_pin:Wide R
in_pin:Top Front L
in_pin:Top Front R
in_pin:Top Mid L
in_pin:Top Mid R
in_pin:Top Back L
in_pin:Top Back R
out_pin:Left
out_pin:Right
out_pin:Center
out_pin:LFE
out_pin:Surround L
out_pin:Surround R
out_pin:Back L
out_pin:Back R
out_pin:Wide L
out_pin:Wide R
out_pin:Top Front L
out_pin:Top Front R
out_pin:Top Mid L
out_pin:Top Mid R
out_pin:Top Back L
out_pin:Top Back R

slider1:1<0,1,1{Off,On}>Run
slider2:0<0,1,1{Off,Reset}>Reset
slider3:400<100,1000,10>Momentary Window (ms)
slider4:3000<1000,10000,100>Short-Term Window (ms)
slider5:-100<-100,12,0.1>-Momentary Max (LUFS)
slider6:-100<-100,12,0.1>-Short-Term (LUFS)
slider7:-100<-100,12,0.1>-Integrated (LUFS)
slider8:0<0,60,0.1>-Range (LU)
slider9:-100<-100,12,0.1>-True Peak (dBTP)
slider10:0<0,86400,1>-Time (s)
slider11:-100<-100,12,0.1>-Momentary (LUFS)
slider12:-100<-100,12,0.1>-Sample Peak (dB)
slider13:1<0,7,1{Mono,Stereo,Quad,5.1,7.1,7.1.2,7.1.4,9.1.6}>Channel Layout
slider14:300<50,2000,10>RMS Window (ms)
slider15:-100<-100,12,0.1>-RMS 1 (dB)
slider16:-100<-100,12,0.1>-RMS 2 (dB)
slider17:-100<-100,12,0.1>-RMS 3 (dB)
slider18:-100<-100,12,0.1>-RMS 4 (dB)
slider19:-100<-100,12,0.1>-RMS 5 (dB)
slider20:-100<-100,12,0.1>-RMS 6 (dB)
slider21:-100<-100,12,0.1>-RMS 7 (dB)
slider22:-100<-100,12,0.1>-RMS 8 (dB)
slider23:-100<-100,12,0.1>-RMS 9 (dB)
slider24:-100<-100,12,0.1>-RMS 10 (dB)
slider25:-100<-100,12,0.1>-RMS 11 (dB)
slider26:-100<-100,12,0.1>-RMS 12 (dB)
slider27:-100<-100,12,0.1>-RMS 13 (dB)
slider28:-100<-100,12,0.1>-RMS 14 (dB)
slider29:-100<-100,12,0.1>-RMS 15 (dB)
slider30:-100<-100,12,0.1>-RMS 16 (dB)

@init
floor_db = -100;
bins_per_db = 10;
db_per_bin = 0.1;
num_bins = 1024;
max_ch = 16;
surround_weight = 1.41;
last_reset = slider2;
last_srate = srate;
last_layout = -1;

function power_to_lufs(power)
(
  power > 0.000000000001 ? -0.691 + 10 * log10(power) : floor_db;
);

function amp_to_db(amp)
(
  amp > 0.0000001 ? 20 * log10(amp) : floor_db;
);

function cubic_peak(y0, y1, y2, y3, t)
  local(t2 t3 y)
(
  t2 = t * t;
  t3 = t2 * t;
  y = 0.5 * ((2 * y1) + (-y0 + y2) * t + (2 * y0 - 5 * y1 + 4 * y2 - y3) * t2 + (-y0 + 3 * y1 - 3 * y2 + y3) * t3);
  abs(y);
);

// The K-weighting filters are identical on every channel, so the coefficients
// live in globals and only the two delay elements are stored per channel.
function set_shelf_coeffs()
  local(db f0 Q K Vh Vb a0)
(
  db = 3.999843853973347;
  f0 = 1681.974450955533;
  Q = 0.7071752369554196;
  K = tan($pi * f0 / srate);
  Vh = pow(10, db / 20);
  Vb = pow(Vh, 0.4996667741545416);
  a0 = 1 + K / Q + K * K;
  sh_a1 = 2 * (K * K - 1) / a0;
  sh_a2 = (1 - K / Q + K * K) / a0;
  sh_b0 = (Vh + Vb * K / Q + K * K) / a0;
  sh_b1 = 2 * (K * K - Vh) / a0;
  sh_b2 = (Vh - Vb * K / Q + K * K) / a0;
);

function set_highpass_coeffs()
  local(f0 Q K a0)
(
  f0 = 38.13547087602444;
  Q = 0.5003270373238773;
  K = tan($pi * f0 / srate);
  a0 = 1 + K / Q + K * K;
  hp_a1 = 2 * (K * K - 1) / a0;
  hp_a2 = (1 - K / Q + K * K) / a0;
  hp_b0 = 1;
  hp_b1 = -2;
  hp_b2 = 1;
);

function shelf_process(idx, x)
  local(y ptr)
(
  ptr = filt_base + idx * 4;
  y = sh_b0 * x + ptr[0];
  ptr[0] = sh_b1 * x - sh_a1 * y + ptr[1];
  ptr[1] = sh_b2 * x - sh_a2 * y;
  y;
);

function highpass_process(idx, x)
  local(y ptr)
(
  ptr = filt_base + idx * 4 + 2;
  y = hp_b0 * x + ptr[0];
  ptr[0] = hp_b1 * x - hp_a1 * y + ptr[1];
  ptr[1] = hp_b2 * x - hp_a2 * y;
  y;
);

function channel_true_peak(idx, x)
  local(ptr y0 y1 y2 pk)
(
  ptr = tp_base + idx * 3;
  y0 = ptr[0];
  y1 = ptr[1];
  y2 = ptr[2];
  pk = abs(x);
  pk = max(pk, cubic_peak(y0, y1, y2, x, 0.25));
  pk = max(pk, cubic_peak(y0, y1, y2, x, 0.50));
  pk = max(pk, cubic_peak(y0, y1, y2, x, 0.75));
  ptr[0] = y1;
  ptr[1] = y2;
  ptr[2] = x;
  pk;
);

function init_filters()
(
  set_shelf_coeffs();
  set_highpass_coeffs();
  memset(filt_base, 0, max_ch * 4);
  memset(tp_base, 0, max_ch * 3);
);

function init_buffers()
(
  momentary_size = max(1, floor(srate * 0.4));
  short_size = max(1, floor(srate * 3));
  update_size = max(1, floor(srate * 0.1));
  momentary_base = 0;
  short_base = momentary_base + momentary_size + 16;
  integrated_count_base = short_base + short_size + 16;
  integrated_sum_base = integrated_count_base + num_bins + 16;
  lra_count_base = integrated_sum_base + num_bins + 16;
  filt_base = lra_count_base + num_bins + 16;
  tp_base = filt_base + max_ch * 4 + 16;
  weight_base = tp_base + max_ch * 3 + 16;
  rms_base = weight_base + max_ch + 16;
  memset(momentary_base, 0, momentary_size);
  memset(short_base, 0, short_size);
  memset(integrated_count_base, 0, num_bins);
  memset(integrated_sum_base, 0, num_bins);
  memset(lra_count_base, 0, num_bins);
  memset(filt_base, 0, max_ch * 4);
  memset(tp_base, 0, max_ch * 3);
  memset(weight_base, 0, max_ch);
  memset(rms_base, 0, max_ch);
);

// One-pole averager rather than a ring buffer: an RMS bar is a slow reading and
// eight windows of a second each would be a lot of memory for nothing.
function set_rms_window()
  local(tau)
(
  tau = max(0.01, min(2, slider14 * 0.001));
  rms_coeff = 1 - exp(-1 / (srate * tau));
);

// Power weights per ITU-R BS.1770-4: front channels 1.0, surround and back
// channels 1.41, LFE excluded from the loudness sum but still peak metered.
//
// BS.1770-4 predates the immersive beds and lists no coefficient for height
// channels, so they take the 1.0 its own rule gives anything unlisted - which is
// also what the Atmos loudness implementations use. Wide channels are front
// positions and take 1.0 as well. From 7.1 up, everything above channel 8 is a
// height or wide position, so the tail is simply filled with 1.0.
function apply_layout()
  local(lay i)
(
  lay = min(7, max(0, floor(slider13)));
  lay == 0 ? layout_ch = 1 :
  lay == 1 ? layout_ch = 2 :
  lay == 2 ? layout_ch = 4 :
  lay == 3 ? layout_ch = 6 :
  lay == 4 ? layout_ch = 8 :
  lay == 5 ? layout_ch = 10 :
  lay == 6 ? layout_ch = 12 : layout_ch = 16;
  memset(weight_base, 0, max_ch);
  lay == 0 ? (
    weight_base[0] = 1;
  ) : lay == 1 ? (
    weight_base[0] = 1;
    weight_base[1] = 1;
  ) : lay == 2 ? (
    weight_base[0] = 1;
    weight_base[1] = 1;
    weight_base[2] = surround_weight;
    weight_base[3] = surround_weight;
  ) : (
    weight_base[0] = 1;
    weight_base[1] = 1;
    weight_base[2] = 1;
    weight_base[3] = 0;
    weight_base[4] = surround_weight;
    weight_base[5] = surround_weight;
    lay >= 4 ? (
      weight_base[6] = surround_weight;
      weight_base[7] = surround_weight;
      i = 8;
      while (i < layout_ch) (
        weight_base[i] = 1;
        i += 1;
      );
    );
  );
  last_layout = lay;
);

function reset_meter()
(
  init_buffers();
  init_filters();
  apply_layout();
  set_rms_window();
  momentary_sum = 0;
  short_sum = 0;
  momentary_pos = 0;
  short_pos = 0;
  momentary_count = 0;
  short_count = 0;
  update_counter = 0;
  momentary_lufs = floor_db;
  short_lufs = floor_db;
  integrated_lufs = floor_db;
  momentary_max = floor_db;
  lra_value = 0;
  integrated_abs_sum = 0;
  integrated_abs_count = 0;
  lra_abs_sum = 0;
  lra_abs_count = 0;
  true_peak = 0;
  sample_peak = 0;
  elapsed_samples = 0;
  slider5 = floor_db;
  slider6 = floor_db;
  slider7 = floor_db;
  slider8 = 0;
  slider9 = floor_db;
  slider10 = 0;
  slider11 = floor_db;
  slider12 = floor_db;
  slider15 = floor_db;
  slider16 = floor_db;
  slider17 = floor_db;
  slider18 = floor_db;
  slider19 = floor_db;
  slider20 = floor_db;
  slider21 = floor_db;
  slider22 = floor_db;
);

function add_integrated_window(db, power)
  local(bin)
(
  db > -70 ? (
    bin = floor((db + 70) * bins_per_db);
    bin < 0 ? bin = 0;
    bin >= num_bins ? bin = num_bins - 1;
    integrated_abs_sum += power;
    integrated_abs_count += 1;
    integrated_count_base[bin] += 1;
    integrated_sum_base[bin] += power;
  );
);

function calculate_integrated()
  local(abs_db gate_bin bin sum count)
(
  integrated_abs_count > 0 ? (
    abs_db = power_to_lufs(integrated_abs_sum / integrated_abs_count);
    gate_bin = floor((abs_db - 10 + 70) * bins_per_db);
    gate_bin < 0 ? gate_bin = 0;
    gate_bin >= num_bins ? gate_bin = num_bins - 1;
    sum = 0;
    count = 0;
    bin = gate_bin;
    loop(num_bins - gate_bin,
      count += integrated_count_base[bin];
      sum += integrated_sum_base[bin];
      bin += 1;
    );
    integrated_lufs = sum > 0 && count > 0 ? power_to_lufs(sum / count) : floor_db;
  );
);

function add_lra_window(db, power)
  local(bin)
(
  db > -70 ? (
    bin = floor((db + 70) * bins_per_db);
    bin < 0 ? bin = 0;
    bin >= num_bins ? bin = num_bins - 1;
    lra_abs_sum += power;
    lra_abs_count += 1;
    lra_count_base[bin] += 1;
  );
);

function calculate_lra()
  local(abs_db gate_bin bin count low_target high_target low_count high_count low_bin high_bin)
(
  lra_abs_count >= 20 ? (
    abs_db = power_to_lufs(lra_abs_sum / lra_abs_count);
    gate_bin = floor((abs_db - 20 + 70) * bins_per_db);
    gate_bin < 0 ? gate_bin = 0;
    gate_bin >= num_bins ? gate_bin = num_bins - 1;
    count = 0;
    bin = gate_bin;
    loop(num_bins - gate_bin,
      count += lra_count_base[bin];
      bin += 1;
    );
    count >= 20 ? (
      low_target = count * 0.10;
      high_target = count * 0.05;
      low_count = 0;
      bin = gate_bin;
      while(bin < num_bins && low_count < low_target)
      (
        low_count += lra_count_base[bin];
        bin += 1;
      );
      low_bin = max(gate_bin, bin - 1);
      high_count = 0;
      bin = num_bins - 1;
      while(bin >= gate_bin && high_count < high_target)
      (
        high_count += lra_count_base[bin];
        bin -= 1;
      );
      high_bin = min(num_bins - 1, bin + 1);
      lra_value = max(0, (high_bin - low_bin) * db_per_bin);
    );
  );
);

function channel_rms_db(idx)
(
  idx < active_ch ? amp_to_db(sqrt(rms_base[idx])) : floor_db;
);

function update_outputs()
  local(m_power s_power tp_db sample_db)
(
  momentary_count >= momentary_size ? (
    m_power = momentary_sum / momentary_size;
    momentary_lufs = power_to_lufs(m_power);
    momentary_max = max(momentary_max, momentary_lufs);
    add_integrated_window(momentary_lufs, m_power);
    calculate_integrated();
  );
  short_count >= short_size ? (
    s_power = short_sum / short_size;
    short_lufs = power_to_lufs(s_power);
    add_lra_window(short_lufs, s_power);
    calculate_lra();
  );
  tp_db = amp_to_db(true_peak);
  sample_db = amp_to_db(sample_peak);
  slider5 = momentary_max;
  slider6 = short_lufs;
  slider7 = integrated_lufs;
  slider8 = lra_value;
  slider9 = tp_db;
  slider10 = elapsed_samples / max(1, srate);
  slider11 = momentary_lufs;
  slider12 = sample_db;
  sliderchange(slider5);
  sliderchange(slider6);
  sliderchange(slider7);
  sliderchange(slider8);
  sliderchange(slider9);
  sliderchange(slider10);
  sliderchange(slider11);
  sliderchange(slider12);
  slider15 = channel_rms_db(0);
  slider16 = channel_rms_db(1);
  slider17 = channel_rms_db(2);
  slider18 = channel_rms_db(3);
  slider19 = channel_rms_db(4);
  slider20 = channel_rms_db(5);
  slider21 = channel_rms_db(6);
  slider22 = channel_rms_db(7);
  slider23 = channel_rms_db(8);
  slider24 = channel_rms_db(9);
  slider25 = channel_rms_db(10);
  slider26 = channel_rms_db(11);
  slider27 = channel_rms_db(12);
  slider28 = channel_rms_db(13);
  slider29 = channel_rms_db(14);
  slider30 = channel_rms_db(15);
  sliderchange(slider15);
  sliderchange(slider16);
  sliderchange(slider17);
  sliderchange(slider18);
  sliderchange(slider19);
  sliderchange(slider20);
  sliderchange(slider21);
  sliderchange(slider22);
  sliderchange(slider23);
  sliderchange(slider24);
  sliderchange(slider25);
  sliderchange(slider26);
  sliderchange(slider27);
  sliderchange(slider28);
  sliderchange(slider29);
  sliderchange(slider30);
);

reset_meter();

@slider
reset_needed = 0;
slider3 = 400;
slider4 = 3000;
(last_srate != srate) ? (
  last_srate = srate;
  reset_needed = 1;
);
(last_layout != min(7, max(0, floor(slider13)))) ? reset_needed = 1;
set_rms_window();
slider2 >= 0.5 ? reset_needed = 1;
last_reset = slider2;
reset_needed ? (
  reset_meter();
  update_outputs();
  slider2 = 0;
  sliderchange(slider2);
  last_reset = slider2;
);

@block
// num_ch can still be unset while @init runs and changes when the track is
// rewired, so the working channel count is resolved per block rather than
// once at reset. Without this the meter can silently stay on channel 1.
active_ch = min(layout_ch, num_ch);
active_ch < 1 ? active_ch = 1;

@sample
slider1 >= 0.5 ? (
  ch = 0;
  p = 0;
  loop(active_ch,
    x = spl(ch);
    ax = abs(x);
    ax > sample_peak ? sample_peak = ax;
    tp = channel_true_peak(ch, x);
    tp > true_peak ? true_peak = tp;
    rms_base[ch] += rms_coeff * (x * x - rms_base[ch]);
    w = weight_base[ch];
    w > 0 ? (
      k = highpass_process(ch, shelf_process(ch, x));
      p += w * k * k;
    );
    ch += 1;
  );
  true_peak = max(true_peak, sample_peak);

  old_m = momentary_base[momentary_pos];
  momentary_sum += p - old_m;
  momentary_base[momentary_pos] = p;
  momentary_pos += 1;
  momentary_pos >= momentary_size ? momentary_pos = 0;
  momentary_count < momentary_size ? momentary_count += 1;

  old_s = short_base[short_pos];
  short_sum += p - old_s;
  short_base[short_pos] = p;
  short_pos += 1;
  short_pos >= short_size ? short_pos = 0;
  short_count < short_size ? short_count += 1;

  elapsed_samples += 1;
  update_counter += 1;
  update_counter >= update_size ? (
    update_counter = 0;
    update_outputs();
  );
);
